PORT=5000

# Prisma / Supabase (PostgreSQL Database Connection)
# Format: postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres
DATABASE_URL=your-supabase-postgresql-connection-string

# Supabase (Optional fallback/legacy if raw supabase-js client is needed)
SUPABASE_URL=your-supabase-project-url
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Cloudinary (Image & Video Uploads)
# Obtain these from your Cloudinary dashboard
CLOUDINARY_CLOUD_NAME=your-cloudinary-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# Razorpay (Payment Gateway)
# Obtain these from your Razorpay API Keys dashboard (test or live)
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret

# SMTP Server / Nodemailer (Auth OTP Verification)
# Use Gmail SMTP (with an App Password) or any SMTP provider
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-email-app-password

# PayPal Integration
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-client-secret
PAYPAL_MODE=sandbox

