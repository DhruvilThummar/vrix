datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model CmsSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @default(now()) @map("updated_at")

  @@map("cms_settings")
}

model Product {
  id          String   @id
  title       String
  material    String?
  type        String
  price       Float
  image       String
  images      Json?
  description String?
  alt         String?
  collection  String?
  stock       Int      @default(999)
  isVisible   Boolean  @default(true) @map("is_visible")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("products")
}

model Journal {
  id        String   @id
  title     String
  excerpt   String?
  content   String
  image     String
  date      String?
  readTime  String?  @map("read_time")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("journal")
}

model SecurityLog {
  id        String   @id @default(uuid()) @db.Uuid
  timestamp DateTime @default(now())
  event     String
  userEmail String?  @map("user_email")
  status    String

  @@map("security_logs")
}

model Payment {
  id            String   @id @default(uuid()) @db.Uuid
  orderId       String   @unique @map("order_id")
  paymentId     String?  @map("payment_id")
  signature     String?
  amount        Float
  currency      String   @default("INR")
  status        String   @default("created")
  userEmail     String?  @map("user_email")
  createdAt     DateTime @default(now()) @map("created_at")
  customerName  String?  @map("customer_name")
  customerPhone String?  @map("customer_phone")
  address       String?
  city          String?
  postalCode    String?  @map("postal_code")
  assignedAgent String?  @map("assigned_agent")

  @@map("payments")
}

model DeliveryStaff {
  email     String   @id
  name      String
  role      String   // "agent" or "manager"
  createdAt DateTime @default(now()) @map("created_at")

  @@map("delivery_staff")
}

model VerificationOtp {
  id        String   @id @default(uuid()) @db.Uuid
  email     String
  otp       String
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("verification_otps")
}

model RedeemCode {
  code      String   @id
  discount  Float
  type      String   @default("percentage") // "percentage" or "fixed"
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("redeem_codes")
}
