datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x", "debian-openssl-3.0.x"]
}

model CmsSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @default(now()) @map("updated_at")

  @@map("cms_settings")
}

model Product {
  id                  String   @id
  title               String
  material            String?
  type                String
  price               Float
  originalPrice       Float?   @map("original_price")
  image               String
  images              Json?
  description         String?
  alt                 String?
  sku                 String?
  collection          String?
  stock               Int      @default(999)
  isVisible           Boolean  @default(true)  @map("is_visible")
  isVrixPlusExclusive Boolean  @default(false) @map("is_vrix_plus_exclusive")
  vrixPlusPrice       Float?   @map("vrix_plus_price")
  layoutStyle         String?  @default("2x2") @map("layout_style")
  engravingOptions    Json?    @map("engraving_options")
  giftNoteOptions     Json?    @map("gift_note_options")
  weight              String?
  dimensions          String?
  availableSizes      Json?    @map("available_sizes")
  comparisonOptions   Json?    @map("comparison_options")
  giftOptions         Json?    @map("gift_options")
  tags                Json?
  createdAt           DateTime @default(now()) @map("created_at")

  @@map("products")
}

model Journal {
  id        String   @id
  title     String
  excerpt   String?
  content   String
  image     String
  date      String?
  readTime  String?  @map("read_time")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("journal")
}

model SecurityLog {
  id        String   @id @default(uuid()) @db.Uuid
  timestamp DateTime @default(now())
  event     String
  userEmail String?  @map("user_email")
  status    String

  @@map("security_logs")
}

model Payment {
  id                    String    @id @default(uuid()) @db.Uuid
  orderId               String    @unique @map("order_id")
  paymentId             String?   @map("payment_id")
  signature             String?
  amount                Float
  currency              String    @default("INR")
  status                String    @default("created")
  userEmail             String?   @map("user_email")
  createdAt             DateTime  @default(now()) @map("created_at")
  customerName          String?   @map("customer_name")
  customerPhone         String?   @map("customer_phone")
  address               String?
  city                  String?
  postalCode            String?   @map("postal_code")
  assignedAgent         String?   @map("assigned_agent")
  estimatedDeliveryDate DateTime? @map("estimated_delivery_date")

  @@map("payments")
}

model DeliveryStaff {
  email     String   @id
  name      String
  role      String   // "agent" or "manager"
  createdAt DateTime @default(now()) @map("created_at")

  @@map("delivery_staff")
}

model VerificationOtp {
  id        String   @id @default(uuid()) @db.Uuid
  email     String
  otp       String
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("verification_otps")
}

model RedeemCode {
  code        String   @id
  discount    Float
  type        String   @default("percentage") // "percentage" or "fixed"
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  description String?
  minSubtotal Float?   @map("min_subtotal")
  usageLimit  Int?     @map("usage_limit")
  usedCount   Int      @default(0) @map("used_count")
  expiryDate  String?  @map("expiry_date")

  @@map("redeem_codes")
}

model User {
  email              String   @id
  name               String?
  phone              String?
  password           String?
  role               String?  @default("customer")
  isVrixPlusMember   Boolean  @default(false) @map("is_vrix_plus_member")
  vrixPlusJoinedDate String?  @map("vrix_plus_joined_date")
  dateOfBirth        String?  @map("date_of_birth")
  createdAt          DateTime @default(now()) @map("created_at")

  @@map("users")
}

model Notification {
  id        String   @id @default(uuid())
  type      String
  title     String
  message   String
  isRead    Boolean  @default(false) @map("is_read")
  userEmail String?  @map("user_email")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("notifications")
}

model CookieConsent {
  id            String   @id @default(uuid())
  userId        String?  @map("user_id")
  sessionId     String   @map("session_id")
  ipHash        String   @map("ip_hash")
  region        String   @default("GLOBAL")
  necessary     Boolean  @default(true)
  analytics     Boolean  @default(false)
  marketing     Boolean  @default(false)
  preferences   Boolean  @default(false)
  consentSource String   @default("banner") @map("consent_source")
  userAgent     String?  @map("user_agent")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([sessionId])
  @@index([region])
  @@map("cookie_consents")
}



